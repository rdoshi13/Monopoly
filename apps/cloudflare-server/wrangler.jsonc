{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rdoshi13-monopoly",
  "account_id": "03fa06c1334ae6ef4fd3aff628ba23a0",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-11",
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/rooms", "/rooms/*", "/ws"]
  },
  "durable_objects": { "bindings": [{ "name": "GAME_HUB", "class_name": "GameHub" }, { "name": "ROOM_LIMITER", "class_name": "RoomLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameHub"] }, { "tag": "v2", "new_sqlite_classes": ["RoomLimiter"] }],
  "vars": { "ALLOWED_ORIGIN": "https://rdoshi13-monopoly.rdoshi13.workers.dev" }
}
