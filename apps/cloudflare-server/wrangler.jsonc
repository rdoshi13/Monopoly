{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monopoly-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-11",
  "durable_objects": { "bindings": [{ "name": "GAME_HUB", "class_name": "GameHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameHub"] }],
  "vars": { "ALLOWED_ORIGIN": "http://localhost:5173" }
}
